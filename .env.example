# KereShop environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Gemini (voice note parsing). Get a key at https://aistudio.google.com/apikey
# If unset, the server falls back to a simple rule-based parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI fallback for order parsing (used in lib/parse-order.js)
OPENAI_API_KEY=

# Cloudinary (product image uploads — drag & drop on the product form).
# Free tier: https://cloudinary.com/console -> Dashboard -> API Keys.
# If unset, /api/upload returns 503 and the form shows the reason.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required on Vercel: a MongoDB connection string (a free MongoDB Atlas M0
# cluster works). The in-memory demo database only runs locally — on
# serverless the app shows a setup screen instead until this is set.
# Locally, leaving it empty runs the app with a throwaway in-memory MongoDB.
MONGODB_URI=