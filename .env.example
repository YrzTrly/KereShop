# KereShop environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Gemini (voice note parsing). Get a key at https://aistudio.google.com/apikey
# If unset, the server falls back to a simple rule-based parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI fallback for order parsing (used in lib/parse-order.js)
OPENAI_API_KEY=

# Optional MongoDB connection string. If unset, the app runs with an in-memory store.
MONGODB_URI=