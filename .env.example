# KereShop environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Gemini (voice note parsing). Get a key at https://aistudio.google.com/apikey
# If unset, the server falls back to a simple rule-based parser.
GEMINI_API_KEY=

# Optional: model used for voice note parsing. The default (gemini-3.5-flash-lite)
# is Google's current recommendation; if it is unavailable the server
# automatically falls back to other available flash models.
#GEMINI_MODEL=gemini-3.5-flash-lite

# Product image uploads (drag & drop on the product form).
# Files are stored locally in data/uploads/ and served by the app itself at
# /api/files/<name> — no external service or API keys required.
# To use a different storage directory, set UPLOAD_DIR=/absolute/path.
# Note: on serverless platforms (e.g. Vercel) the working directory is
# read-only, so uploads fall back to the per-instance temp dir (/tmp) —
# they work, but files are not durable. For durable storage run on a
# VPS/VM and point UPLOAD_DIR at a real volume.

# Required on Vercel: a MongoDB connection string (a free MongoDB Atlas M0
# cluster works). The in-memory demo database only runs locally — on
# serverless the app shows a setup screen instead until this is set.
# Locally, leaving it empty runs the app with a throwaway in-memory MongoDB.
MONGODB_URI=